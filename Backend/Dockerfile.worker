FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Production Runner
FROM node:20-alpine

# Install dependencies for code execution (Compilers & Interpreters)
# Also install Docker CLI to allow Docker-in-Docker via socket mounting
RUN apk add --no-cache docker-cli python3 make g++ openjdk17-jdk && \
    ln -sf python3 /usr/bin/python

WORKDIR /app

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Create logs directory
RUN mkdir -p logs

# Environment variables
ENV NODE_ENV=production

# Start Worker
CMD ["node", "dist/worker.js"]
