# ============================================
# LETS PREP - Production .gitignore
# ============================================

# ============================================
# Dependencies
# ============================================
**/node_modules/
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/.pnp
**/.pnp.js

# ============================================
# Environment Variables (CRITICAL - DO NOT COMMIT)
# ============================================
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/.env.*.local

# ============================================
# Next.js
# ============================================
Frontend/.next/
Frontend/out/
Frontend/build/
Frontend/dist/
Frontend/.vercel
Frontend/.turbo

# ============================================
# TypeScript
# ============================================
*.tsbuildinfo
**/.tsbuildinfo

# ============================================
# Testing
# ============================================
**/coverage/
**/.nyc_output/
**/*.lcov

# ============================================
# Build Outputs
# ============================================
Backend/dist/
Backend/build/
**/dist/
**/build/

# ============================================
# Logs
# ============================================
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/lerna-debug.log*
**/.npm

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
Desktop.ini
**/.DS_Store
**/Thumbs.db

# ============================================
# IDE / Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace
.history/

# ============================================
# Docker
# ============================================
**/.dockerignore
**/docker-compose.override.yml

# ============================================
# Database
# ============================================
**/*.sqlite
**/*.sqlite3
**/*.db

# ============================================
# Temporary Files
# ============================================
**/tmp/
**/temp/
**/.cache/
**/.temp/

# ============================================
# Package Manager Locks (Keep for consistency)
# ============================================
# Uncomment if you want to ignore lock files
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# Supabase
# ============================================
**/supabase/.branches/
**/supabase/.temp/

# ============================================
# Secrets & Keys (CRITICAL)
# ============================================
**/*.pem
**/*.key
**/*.cert
**/secrets/
**/.secrets/

# ============================================
# Misc
# ============================================
**/.eslintcache
**/storybook-static/
**/.storybook-out/
