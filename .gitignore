# Git Secrets Prevention
# This file helps prevent accidental commits of sensitive data

# Environment files
.env
.env.local
.env.development
.env.production
.env.test
.env*.local

# API Keys and Secrets
**/secrets/
**/credentials/
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Database
*.sqlite
*.db
*.sql.gz
dump.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.cache/

# Testing
coverage/
.nyc_output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp

# Docker
.dockerignore
docker-compose.override.yml

# Misc
.eslintcache
.stylelintcache
*.tsbuildinfo
